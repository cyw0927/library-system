APP_NAME=Library App API
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/library_app

# Maximum connection and query time, in seconds.
DATABASE_TIMEOUT_SECONDS=5

# Source of truth. README is metadata; book content is never pushed back.
GITHUB_REPOSITORY=cyw0927/library
GITHUB_BRANCH=main
# Required for private source repos; use a read-only fine-grained token.
GITHUB_TOKEN=
# Optional local clone. Blobs are accepted only when GitHub SHA matches.
GITHUB_CACHE_DIR=
# Explicit local-development opt-in to the already logged-in Git credential manager.
GITHUB_USE_GIT_CREDENTIALS=false

# Private/mutating endpoints require this. scripts.dev generates an ephemeral token
# and shares it between the two localhost processes if this is left blank.
ADMIN_TOKEN=
LIBRARY_API_URL=http://127.0.0.1:8000

# Enable invite-only accounts locally; production forces authentication even if false.
AUTH_REQUIRED=false
SESSION_HOURS=8
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Optional mounted-secret directory for database_url/github_token/openai_api_key files.
LIBRARY_SECRETS_DIR=

# Optional paid AI. Default /ask mode only returns local text excerpts.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_MAX_SOURCES=8
RAG_VECTOR_SCAN_LIMIT=5000

# Only needed with docker compose; set a strong password and match DATABASE_URL.
POSTGRES_PASSWORD=
